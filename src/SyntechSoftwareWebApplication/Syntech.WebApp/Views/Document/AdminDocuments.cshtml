@model IEnumerable<Syntech.WebApp.Models.Project>

@{
ViewData["Title"] = "Document Management";
}

<div class="container mt-4 mb-5">

<!-- Page Header -->
<div class="document-page-heading">

    <div class="document-title-icon">
        <i class="bi bi-folder2-open"></i>
    </div>

    <div>
        <h2 class="mb-1">Document Management</h2>

        <p class="text-muted mb-0">
            Manage documents across all projects.
        </p>
    </div>

</div>


<!-- Projects Section -->
<div class="document-card">

    <div class="document-card-header">

        <div>
            <h5 class="mb-1">All Projects</h5>

            <p class="text-muted mb-0">
                Select a project to manage its documents.
            </p>
        </div>

        @if (Model.Any())
        {
            <span class="document-count">
                @Model.Count() @(Model.Count() == 1 ? "project" : "projects")
            </span>
        }

    </div>


    @if (!Model.Any())
    {
        <div class="document-empty-state">

            <div class="document-empty-icon">
                <i class="bi bi-folder-x"></i>
            </div>

            <h5>No Projects Available</h5>

            <p class="text-muted mb-0">
                There are currently no projects.
            </p>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table syntech-document-table align-middle mb-0">

                <thead>

                    <tr>

                        <th>
                            Project
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Progress
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var project in Model)
                    {
                        <tr>

                            <td>

                                <div class="document-file-name">

                                    <div class="document-file-icon">
                                        <i class="bi bi-folder"></i>
                                    </div>

                                    <span>
                                        @project.ProjectName
                                    </span>

                                </div>

                            </td>


                            <td>

                                <span class="project-status-badge">
                                    @project.Status
                                </span>

                            </td>


                            <td>

                                <div class="project-progress-wrapper">

                                    <div class="project-progress-info">
                                        <span>
                                            @project.ProgressPercentage%
                                        </span>
                                    </div>

                                    <div class="progress project-progress">

                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width: @project.ProgressPercentage%;"
                                             aria-valuenow="@project.ProgressPercentage"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <div class="document-actions">

                                    <a asp-controller="Document"
                                       asp-action="Index"
                                       asp-route-projectId="@project.ProjectID"
                                       class="btn btn-sm syntech-primary-btn">

                                        <i class="bi bi-folder2-open me-1"></i>
                                        Manage Documents

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

</div>
