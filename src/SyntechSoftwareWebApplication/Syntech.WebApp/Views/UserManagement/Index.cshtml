@model IEnumerable<Syntech.WebApp.Models.UserManagementViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1>
                User Management
            </h1>

            <p class="text-muted mb-0">
                Manage users registered in the Syntech Software system.
            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-controller="UserManagement"
               asp-action="Create"
               class="btn btn-primary">

                Create User

            </a>


            <a asp-controller="AdminDashboard"
               asp-action="Index"
               class="btn btn-secondary">

                Back to Dashboard

            </a>

        </div>

    </div>


    @* ================================================================
       SUCCESS MESSAGE
       ================================================================ *@

    @if (TempData["UserManagementSuccess"] != null)
    {
        <div class="alert alert-success"
             role="alert">

            @TempData["UserManagementSuccess"]

        </div>
    }


    @* ================================================================
       ERROR MESSAGE
       ================================================================ *@

    @if (TempData["UserManagementError"] != null)
    {
        <div class="alert alert-danger"
             role="alert">

            @TempData["UserManagementError"]

        </div>
    }


    @* ================================================================
       USER COUNT
       ================================================================ *@

    <div class="alert alert-info">

        Total registered users:
        <strong>@Model.Count()</strong>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    User ID
                                </th>

                                <th>
                                    Full Name
                                </th>

                                <th>
                                    Email Address
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var user in Model)
                            {
                                <tr>

                                    <td>
                                        @user.UserId
                                    </td>


                                    <td>
                                        @user.Name
                                    </td>


                                    <td>
                                        @user.Email
                                    </td>


                                    <td>

                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger">
                                                Admin
                                            </span>
                                        }
                                        else if (user.Role == "Developer")
                                        {
                                            <span class="badge bg-primary">
                                                Developer
                                            </span>
                                        }
                                        else if (user.Role == "Client")
                                        {
                                            <span class="badge bg-success">
                                                Client
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @user.Role
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Deactivated
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="d-flex gap-2 flex-wrap">

                                            @* EDIT *@

                                            <a asp-controller="UserManagement"
                                               asp-action="Edit"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-outline-primary">

                                                Edit

                                            </a>


                                            @* ACTIVATE / DEACTIVATE *@

                                            @if (user.IsActive)
                                            {
                                                <form asp-controller="UserManagement"
                                                      asp-action="SetActiveStatus"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@user.UserId" />

                                                    <input type="hidden"
                                                           name="isActive"
                                                           value="false" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-warning">

                                                        Deactivate

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="UserManagement"
                                                      asp-action="SetActiveStatus"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@user.UserId" />

                                                    <input type="hidden"
                                                           name="isActive"
                                                           value="true" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">

                                                        Activate

                                                    </button>

                                                </form>
                                            }


                                            @* DELETE *@

                                            <a asp-controller="UserManagement"
                                               asp-action="Delete"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-outline-danger">

                                                Delete

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">

                    No users were found in the database.

                </div>
            }

        </div>

    </div>

</div>