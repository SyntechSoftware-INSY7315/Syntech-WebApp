@model Syntech.WebApp.Models.Ticket.TicketListViewModel
@{
    ViewData["Title"] = "Support Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Support Tickets</h2>
        <p class="text-muted mb-0">
            @if (User.IsInRole("Admin"))
            {
                <span>All tickets across the platform.</span>
            }
            else if (User.IsInRole("Developer"))
            {
                <span>Tickets assigned to you.</span>
            }
            else
            {
                <span>Your submitted support requests.</span>
            }
        </p>
    </div>
    @if (User.IsInRole("Client"))
    {
        <a asp-action="Create" class="btn btn-primary">+ New Ticket</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-primary">@Model.OpenCount</div>
            <div class="text-muted small">Open</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-warning">@Model.InProgressCount</div>
            <div class="text-muted small">In Progress</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-success">@Model.ResolvedCount</div>
            <div class="text-muted small">Resolved</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-2 fw-bold text-secondary">@Model.ClosedCount</div>
            <div class="text-muted small">Closed</div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by title or client name..." />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    @if (Model.StatusFilter == "Open")
                    {
                        <option value="Open" selected="selected">Open</option>
                    }
                    else
                    {
                        <option value="Open">Open</option>
                    }
                    @if (Model.StatusFilter == "InProgress")
                    {
                        <option value="InProgress" selected="selected">In Progress</option>
                    }
                    else
                    {
                        <option value="InProgress">In Progress</option>
                    }
                    @if (Model.StatusFilter == "Resolved")
                    {
                        <option value="Resolved" selected="selected">Resolved</option>
                    }
                    else
                    {
                        <option value="Resolved">Resolved</option>
                    }
                    @if (Model.StatusFilter == "Closed")
                    {
                        <option value="Closed" selected="selected">Closed</option>
                    }
                    else
                    {
                        <option value="Closed">Closed</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold">Priority</label>
                <select name="priority" class="form-select">
                    <option value="">All</option>
                    @if (Model.PriorityFilter == "Low")
                    {
                        <option value="Low" selected="selected">Low</option>
                    }
                    else
                    {
                        <option value="Low">Low</option>
                    }
                    @if (Model.PriorityFilter == "Medium")
                    {
                        <option value="Medium" selected="selected">Medium</option>
                    }
                    else
                    {
                        <option value="Medium">Medium</option>
                    }
                    @if (Model.PriorityFilter == "High")
                    {
                        <option value="High" selected="selected">High</option>
                    }
                    else
                    {
                        <option value="High">High</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Tickets.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-3">No tickets found.</p>
            @if (User.IsInRole("Client"))
            {
                <a asp-action="Create" class="btn btn-primary">Submit Your First Ticket</a>
            }
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-muted small fw-semibold">#</th>
                        <th class="text-muted small fw-semibold">Title</th>
                        @if (!User.IsInRole("Client"))
                        {
                            <th class="text-muted small fw-semibold">Client</th>
                        }
                        <th class="text-muted small fw-semibold">Priority</th>
                        <th class="text-muted small fw-semibold">Status</th>
                        <th class="text-muted small fw-semibold">Assigned To</th>
                        <th class="text-muted small fw-semibold">Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model.Tickets)
                    {
                        <tr>
                            <td class="text-muted small">#@ticket.TicketId</td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@ticket.TicketId"
                                   class="text-decoration-none fw-semibold text-dark">
                                    @ticket.Title
                                </a>
                            </td>
                            @if (!User.IsInRole("Client"))
                            {
                                <td>@(ticket.Client?.Name ?? "—")</td>
                            }
                            <td>
                                @if (ticket.Priority == "High")
                                {
                                    <span class="badge bg-danger">High</span>
                                }
                                else if (ticket.Priority == "Medium")
                                {
                                    <span class="badge bg-warning text-dark">Medium</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Low</span>
                                }
                            </td>
                            <td>
                                @if (ticket.Status == "Open")
                                {
                                    <span class="badge bg-primary">Open</span>
                                }
                                else if (ticket.Status == "InProgress")
                                {
                                    <span class="badge bg-warning text-dark">In Progress</span>
                                }
                                else if (ticket.Status == "Resolved")
                                {
                                    <span class="badge bg-success">Resolved</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Closed</span>
                                }
                            </td>
                            <td>@(ticket.AssignedDeveloper?.Name ?? "—")</td>
                            <td class="text-muted small">@ticket.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@ticket.TicketId"
                                   class="btn btn-outline-primary btn-sm">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
