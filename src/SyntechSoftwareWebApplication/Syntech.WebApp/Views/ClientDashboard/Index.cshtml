@{
    ViewData["Title"] = "Client Dashboard";
}

<div class="container mt-5">

    <div class="card shadow-sm">

        <div class="card-body p-5">

            <h1 class="mb-3">
                Client Dashboard
            </h1>

            <p class="lead">
                Welcome, @User.Identity?.Name.
            </p>

            <p>
                You are authenticated as a
                <strong>Client</strong>.
            </p>

            <hr />

            <p class="text-muted">
                Client functionality will be implemented here,
                including the functionality assigned to the Client
                role.
            </p>

        </div>

    </div>

</div>