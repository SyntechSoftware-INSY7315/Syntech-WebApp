@model IEnumerable<Syntech.WebApp.Models.ClientProjectListItemViewModel>

@{
    ViewData["Title"] = "Client Dashboard";
    var count = Model?.Count() ?? 0;
}

<div class="container mt-4 mb-5">

    <div class="document-page-header">
        <div class="document-page-title">
            <div class="document-title-icon">
                <i class="bi bi-person-workspace"></i>
            </div>
            <div>
                <h2 class="mb-1">Client Dashboard</h2>
                <p class="text-muted mb-0">
                    Welcome, @User.Identity?.Name. Projects assigned to you.
                </p>
            </div>
        </div>
    </div>

    <div class="document-card">
        <div class="document-card-header">
            <h5 class="mb-0">My Projects</h5>
            <span class="document-count">@count project(s)</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="document-empty-state">
                <div class="document-empty-icon">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <h5>No projects yet</h5>
                <p class="text-muted mb-0">
                    You do not have any projects assigned yet.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table syntech-document-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Start</th>
                            <th>Deadline</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="document-file-name">
                                        <div class="document-file-icon">
                                            <i class="bi bi-briefcase"></i>
                                        </div>
                                        <span>@item.ProjectName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="project-status-badge">@item.Status</span>
                                </td>
                                <td>
                                    <div class="project-progress-wrapper">
                                        <div class="project-progress-info">
                                            <span>@item.ProgressPercentage.ToString("0")%</span>
                                        </div>
                                        <div class="progress project-progress">
                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 style="width: @(item.ProgressPercentage)%;"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="document-date">
                                    @(item.StartDate?.ToString("yyyy-MM-dd") ?? "—")
                                </td>
                                <td class="document-date">
                                    @(item.Deadline?.ToString("yyyy-MM-dd") ?? "—")
                                </td>
                                <td>
                                    <div class="document-actions">
                                        <a asp-action="ProjectDetails"
                                           asp-route-id="@item.ProjectID"
                                           class="btn btn-sm syntech-primary-btn">
                                            Details
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>