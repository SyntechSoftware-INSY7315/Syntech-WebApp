@model Syntech.WebApp.Models.Project

@{
    ViewData["Title"] = "Project Details";
    var updateCount = Model.ProjectUpdates?.Count ?? 0;
}

<div class="container mt-4 mb-5">

    <div class="document-back-navigation">
        <a asp-action="Index" class="document-back-btn">
            <i class="bi bi-arrow-left"></i> Back to My Projects
        </a>
    </div>

    <div class="document-page-header">
        <div class="document-page-title">
            <div class="document-title-icon">
                <i class="bi bi-briefcase"></i>
            </div>
            <div>
                <h2 class="mb-1">@Model.ProjectName</h2>
                <p class="text-muted mb-0">Project details and progress updates.</p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="document-card h-100">
                <div class="document-card-header">
                    <h5 class="mb-0">Overview</h5>
                    <span class="project-status-badge">@Model.Status</span>
                </div>
                <div class="p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Progress</dt>
                        <dd class="col-sm-9">
                            <div class="project-progress-wrapper" style="max-width:280px;">
                                <div class="project-progress-info">
                                    <span>@Model.ProgressPercentage.ToString("0")%</span>
                                </div>
                                <div class="progress project-progress">
                                    <div class="progress-bar" style="width: @(Model.ProgressPercentage)%;"></div>
                                </div>
                            </div>
                        </dd>
                        <dt class="col-sm-3">Start</dt>
                        <dd class="col-sm-9 document-date">@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
                        <dt class="col-sm-3">Deadline</dt>
                        <dd class="col-sm-9 document-date">@(Model.Deadline?.ToString("yyyy-MM-dd") ?? "—")</dd>
                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">
                            @if (string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <span class="text-muted">No description provided.</span>
                            }
                            else
                            {
                                @Model.Description
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="document-card h-100">
                <div class="document-card-header">
                    <h5 class="mb-0">Summary</h5>
                </div>
                <div class="p-4">
                    <p class="mb-2">
                        <strong>Updates:</strong> @updateCount
                    </p>
                    <p class="text-muted mb-0 small">
                        This page is read-only. Contact your project team if you need changes.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="document-card">
        <div class="document-card-header">
            <h5 class="mb-0">Progress updates</h5>
            <span class="document-count">@updateCount update(s)</span>
        </div>

        @if (Model.ProjectUpdates == null || !Model.ProjectUpdates.Any())
        {
            <div class="document-empty-state">
                <div class="document-empty-icon">
                    <i class="bi bi-journal-text"></i>
                </div>
                <h5>No updates yet</h5>
                <p class="text-muted mb-0">
                    No updates have been posted for this project yet.
                </p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var update in Model.ProjectUpdates)
                {
                    <div class="list-group-item px-4 py-3">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h5 class="mb-1" style="color:#202836;font-weight:650;">@update.UpdateTitle</h5>
                                <p class="mb-2 text-muted">@update.UpdateDescription</p>
                                <small class="document-user">
                                    <i class="bi bi-person me-1"></i>
                                    @(update.User?.Name ?? "Unknown")
                                    <span class="document-date ms-2">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @update.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                </small>
                            </div>
                            @if (update.ProgressPercentage.HasValue)
                            {
                                <span class="document-count">
                                    @update.ProgressPercentage.Value.ToString("0")%
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>