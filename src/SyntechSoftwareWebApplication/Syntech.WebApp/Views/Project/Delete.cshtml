@model Syntech.WebApp.Models.Project

@{
    ViewData["Title"] = "Delete Project";
}

<div class="container mt-4 mb-5">

    <div class="document-back-navigation">
        <a asp-action="Index" class="document-back-btn">
            <i class="bi bi-arrow-left"></i> Back to Projects
        </a>
    </div>

    <div class="document-page-heading">
        <div class="document-title-icon">
            <i class="bi bi-trash"></i>
        </div>
        <div>
            <h2 class="mb-1">Delete Project</h2>
            <p class="text-muted mb-0">This action cannot be undone.</p>
        </div>
    </div>

    <div class="document-card border border-danger">
        <div class="document-card-header">
            <h5 class="mb-0 text-danger">Confirm deletion</h5>
        </div>
        <div class="p-4">
            <div class="syntech-success-alert mb-4" style="color:#842029;background:#f8d7da;border-color:#f5c2c7;">
                Related updates and assignments may also be removed depending on database rules.
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9 fw-semibold">@Model.ProjectName</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><span class="project-status-badge">@Model.Status</span></dd>
                <dt class="col-sm-3">Progress</dt>
                <dd class="col-sm-9">@Model.ProgressPercentage.ToString("0")%</dd>
                <dt class="col-sm-3">Start</dt>
                <dd class="col-sm-9">@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
                <dt class="col-sm-3">Deadline</dt>
                <dd class="col-sm-9">@(Model.Deadline?.ToString("yyyy-MM-dd") ?? "—")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProjectID" />
                <div class="document-upload-actions">
                    <button type="submit" class="syntech-delete-btn btn">Delete Project</button>
                    <a asp-action="Index" class="syntech-cancel-btn">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>