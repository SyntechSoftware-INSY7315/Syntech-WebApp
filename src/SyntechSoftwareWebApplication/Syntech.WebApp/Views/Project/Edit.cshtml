@model Syntech.WebApp.Models.Project

@{
    ViewData["Title"] = "Edit Project";
}

<div class="container mt-4 mb-5">

    <div class="document-back-navigation">
        <a asp-action="Index" class="document-back-btn">
            <i class="bi bi-arrow-left"></i> Back to Projects
        </a>
    </div>

    <div class="document-page-heading">
        <div class="document-title-icon">
            <i class="bi bi-pencil-square"></i>
        </div>
        <div>
            <h2 class="mb-1">Edit Project</h2>
            <p class="text-muted mb-0">Update details and assigned developers.</p>
        </div>
    </div>

    <div class="document-upload-card">
        <div class="document-upload-header">
            <h5 class="mb-0">@Model.ProjectName</h5>
        </div>
        <div class="document-upload-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProjectID" />
                <input type="hidden" asp-for="ClientID" />
                <input type="hidden" asp-for="AdminID" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="ProjectName" class="syntech-form-label">Project name</label>
                        <input asp-for="ProjectName" class="form-control syntech-form-control" />
                        <span asp-validation-for="ProjectName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Status" class="syntech-form-label">Status</label>
                        <select asp-for="Status" class="form-select syntech-form-control">
                            <option value="Planning">Planning</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Testing">Testing</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="syntech-form-label">Description</label>
                        <textarea asp-for="Description" class="form-control syntech-form-control" rows="4"></textarea>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ProgressPercentage" class="syntech-form-label">Progress %</label>
                        <input asp-for="ProgressPercentage" type="number" min="0" max="100" step="1"
                               class="form-control syntech-form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StartDate" class="syntech-form-label">Start date</label>
                        <input asp-for="StartDate" type="date" class="form-control syntech-form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Deadline" class="syntech-form-label">Deadline</label>
                        <input asp-for="Deadline" type="date" class="form-control syntech-form-control" />
                    </div>

                    <div class="col-12">
                        <label class="syntech-form-label">Developers</label>
                        <select asp-for="SelectedDeveloperIDs" class="form-select syntech-form-control" multiple size="6">
                            @if (ViewBag.Developers != null)
                            {
                                foreach (var developer in ViewBag.Developers)
                                {
                                    <option value="@developer.UserId">
                                        @(developer.User?.Name ?? $"Developer {developer.UserId}")
                                    </option>
                                }
                            }
                        </select>
                        <div class="syntech-file-help">
                            <i class="bi bi-info-circle"></i>
                            Hold Ctrl (Windows) or Cmd (Mac) to select multiple.
                        </div>
                    </div>
                </div>

                <div class="document-upload-actions mt-4">
                    <button type="submit" class="syntech-primary-btn">Save Changes</button>
                    <a asp-action="Index" class="syntech-cancel-btn">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}