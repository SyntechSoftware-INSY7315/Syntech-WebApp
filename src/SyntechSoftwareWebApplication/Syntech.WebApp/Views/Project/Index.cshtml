@model IEnumerable<Syntech.WebApp.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-2">Projects</h1>
            <p class="text-muted mb-0">
                Create, search, and manage all projects.
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                Create Project
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Search</label>
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control"
                               placeholder="Project name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <select name="statusFilter" class="form-select">
                            <option value="">All Statuses</option>
                            @foreach (var status in new[] { "Planning", "In Progress", "Testing", "Completed", "Cancelled" })
                            {
                                if (ViewBag.StatusFilter as string == status)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Client</label>
                        <select name="clientFilter" class="form-select">
                            <option value="">All Clients</option>
                            @if (ViewBag.Clients != null)
                            {
                                foreach (var client in ViewBag.Clients)
                                {
                                    var selected = ViewBag.ClientFilter as int? == client.UserId;
                                    if (selected)
                                    {
                                        <option value="@client.UserId" selected>
                                            @(client.User?.Name ?? $"Client {client.UserId}")
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@client.UserId">
                                            @(client.User?.Name ?? $"Client {client.UserId}")
                                        </option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="mb-3">All Projects</h4>

            @if (Model == null || !Model.Any())
            {
                <p class="text-muted mb-0">No projects found.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Project</th>
                                <th>Status</th>
                                <th style="width: 160px;">Progress</th>
                                <th>Start</th>
                                <th>Deadline</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in Model)
                            {
                                <tr>
                                    <td>@project.ProjectName</td>
                                    <td>
                                        <span class="badge bg-secondary">@project.Status</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                <div class="progress-bar"
                                                     role="progressbar"
                                                     style="width: @(project.ProgressPercentage)%;">
                                                </div>
                                            </div>
                                            <span class="small text-muted">
                                                @project.ProgressPercentage.ToString("0")%
                                            </span>
                                        </div>
                                    </td>
                                    <td>@(project.StartDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td>@(project.Deadline?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@project.ProjectID"
                                               class="btn btn-outline-primary">Details</a>
                                            <a asp-action="Edit" asp-route-id="@project.ProjectID"
                                               class="btn btn-outline-secondary">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@project.ProjectID"
                                               class="btn btn-outline-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>