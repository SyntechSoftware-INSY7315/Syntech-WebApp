@model IEnumerable<Syntech.WebApp.Models.Project>

@{
    ViewData["Title"] = "Projects";
    var count = Model?.Count() ?? 0;
}

<div class="container mt-4 mb-5">

    <div class="document-page-header">
        <div class="document-page-title">
            <div class="document-title-icon">
                <i class="bi bi-kanban"></i>
            </div>
            <div>
                <h2 class="mb-1">Projects</h2>
                <p class="text-muted mb-0">Create, search, and manage all projects.</p>
            </div>
        </div>
        <a asp-action="Create" class="syntech-primary-btn">
            <i class="bi bi-plus-lg me-2"></i>Create Project
        </a>
    </div>

    <div class="document-card mb-4">
        <div class="document-card-header">
            <h5 class="mb-0">Search &amp; filter</h5>
        </div>
        <div class="p-3 p-md-4">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="syntech-form-label">Search</label>
                        <input type="text"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               class="form-control syntech-form-control"
                               placeholder="Project name" />
                    </div>
                    <div class="col-md-3">
                        <label class="syntech-form-label">Status</label>
                        <select name="statusFilter" class="form-select syntech-form-control">
                            <option value="">All Statuses</option>
                            @foreach (var status in new[] { "Planning", "In Progress", "Testing", "Completed", "Cancelled" })
                            {
                                if ((ViewBag.StatusFilter as string) == status)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="syntech-form-label">Client</label>
                        <select name="clientFilter" class="form-select syntech-form-control">
                            <option value="">All Clients</option>
                            @if (ViewBag.Clients != null)
                            {
                                foreach (var client in ViewBag.Clients)
                                {
                                    var selected = (ViewBag.ClientFilter as int?) == client.UserId;
                                    if (selected)
                                    {
                                        <option value="@client.UserId" selected>
                                            @(client.User?.Name ?? $"Client {client.UserId}")
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@client.UserId">
                                            @(client.User?.Name ?? $"Client {client.UserId}")
                                        </option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="syntech-primary-btn w-100">
                            <i class="bi bi-search me-1"></i>Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="document-card">
        <div class="document-card-header">
            <h5 class="mb-0">All projects</h5>
            <span class="document-count">@count project(s)</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="document-empty-state">
                <div class="document-empty-icon">
                    <i class="bi bi-folder2-open"></i>
                </div>
                <h5>No projects found</h5>
                <p class="text-muted">Create a project or adjust your filters.</p>
                <a asp-action="Create" class="syntech-primary-btn">Create Project</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table syntech-document-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Start</th>
                            <th>Deadline</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model)
                        {
                            <tr>
                                <td>
                                    <div class="document-file-name">
                                        <div class="document-file-icon">
                                            <i class="bi bi-briefcase"></i>
                                        </div>
                                        <span>@project.ProjectName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="project-status-badge">@project.Status</span>
                                </td>
                                <td>
                                    <div class="project-progress-wrapper">
                                        <div class="project-progress-info">
                                            <span>@project.ProgressPercentage.ToString("0")%</span>
                                        </div>
                                        <div class="progress project-progress">
                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 style="width: @(project.ProgressPercentage)%;"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="document-date">
                                    @(project.StartDate?.ToString("yyyy-MM-dd") ?? "—")
                                </td>
                                <td class="document-date">
                                    @(project.Deadline?.ToString("yyyy-MM-dd") ?? "—")
                                </td>
                                <td>
                                    <div class="document-actions">
                                        <a asp-action="Details" asp-route-id="@project.ProjectID"
                                           class="btn btn-sm syntech-primary-btn">Details</a>
                                        <a asp-action="Edit" asp-route-id="@project.ProjectID"
                                           class="btn btn-sm syntech-cancel-btn">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@project.ProjectID"
                                           class="btn btn-sm syntech-delete-btn">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>