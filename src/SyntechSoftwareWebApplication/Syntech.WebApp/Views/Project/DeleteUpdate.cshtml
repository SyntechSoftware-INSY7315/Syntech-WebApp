@model Syntech.WebApp.Models.ProjectUpdate

@{
    ViewData["Title"] = "Delete Project Update";
}

<div class="container mt-4 mb-5">

    <div class="document-back-navigation">
        <a asp-action="Details" asp-route-id="@Model.ProjectID" class="document-back-btn">
            <i class="bi bi-arrow-left"></i> Back to Project
        </a>
    </div>

    <div class="document-page-heading">
        <div class="document-title-icon">
            <i class="bi bi-trash"></i>
        </div>
        <div>
            <h2 class="mb-1">Delete Project Update</h2>
            <p class="text-muted mb-0">Confirm deletion of this note.</p>
        </div>
    </div>

    <div class="document-card border border-danger">
        <div class="document-card-header">
            <h5 class="mb-0 text-danger">Confirm deletion</h5>
        </div>
        <div class="p-4">
            <dl class="row mb-4">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9 fw-semibold">@Model.UpdateTitle</dd>
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.UpdateDescription</dd>
                <dt class="col-sm-3">Progress</dt>
                <dd class="col-sm-9">
                    @(Model.ProgressPercentage.HasValue
                        ? Model.ProgressPercentage.Value.ToString("0") + "%"
                        : "—")
                </dd>
                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 document-date">@Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>

            <form asp-action="DeleteUpdate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UpdateID" />
                <div class="document-upload-actions">
                    <button type="submit" class="syntech-delete-btn btn">Delete Update</button>
                    <a asp-action="Details" asp-route-id="@Model.ProjectID" class="syntech-cancel-btn">Cancel</a>
                </div>
            </form>
        </div>
    </div>

</div>