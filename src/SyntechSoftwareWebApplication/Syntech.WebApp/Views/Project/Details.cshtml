@model Syntech.WebApp.Models.Project

@{
    ViewData["Title"] = "Project Details";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-2">@Model.ProjectName</h1>
            <p class="text-muted mb-0">Full project overview, team, and updates.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.ProjectID" class="btn btn-outline-secondary">Edit</a>
            <a asp-action="CreateUpdate" asp-route-projectId="@Model.ProjectID" class="btn btn-primary">Add Update</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to Projects</a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="mb-3">Overview</h4>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Status</span></dd>

                        <dt class="col-sm-3">Progress</dt>
                        <dd class="col-sm-9">
                            <div class="d-flex align-items-center gap-2" style="max-width: 320px;">
                                <div class="progress flex-grow-1" style="height: 10px;">
                                    <div class="progress-bar" style="width: @(Model.ProgressPercentage)%;"></div>
                                </div>
                                <span>@Model.ProgressPercentage.ToString("0")%</span>
                            </div>
                        </dd>

                        <dt class="col-sm-3">Start</dt>
                        <dd class="col-sm-9">@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "—")</dd>

                        <dt class="col-sm-3">Deadline</dt>
                        <dd class="col-sm-9">@(Model.Deadline?.ToString("yyyy-MM-dd") ?? "—")</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">
                            @if (string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <span class="text-muted">No description.</span>
                            }
                            else
                            {
                                @Model.Description
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="mb-3">Assigned developers</h4>
                    @if (ViewBag.Developers != null && ViewBag.Developers.Count > 0)
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var dp in ViewBag.Developers)
                            {
                                <li class="mb-2">
                                    @(dp.Developer?.User?.Name ?? $"Developer {dp.DeveloperID}")
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No developers assigned.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Progress updates</h4>
                <a asp-action="CreateUpdate" asp-route-projectId="@Model.ProjectID" class="btn btn-sm btn-primary">
                    Add Update
                </a>
            </div>

            @if (Model.ProjectUpdates == null || !Model.ProjectUpdates.Any())
            {
                <p class="text-muted mb-0">No updates yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Description</th>
                                <th>Progress</th>
                                <th>By</th>
                                <th>Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var update in Model.ProjectUpdates)
                            {
                                <tr>
                                    <td>@update.UpdateTitle</td>
                                    <td>@update.UpdateDescription</td>
                                    <td>
                                        @(update.ProgressPercentage.HasValue
                                            ? update.ProgressPercentage.Value.ToString("0") + "%"
                                            : "—")
                                    </td>
                                    <td>@(update.User?.Name ?? "Unknown")</td>
                                    <td>@update.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="EditUpdate" asp-route-id="@update.UpdateID"
                                               class="btn btn-outline-secondary">Edit</a>
                                            <a asp-action="DeleteUpdate" asp-route-id="@update.UpdateID"
                                               class="btn btn-outline-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>