@{
    ViewData["Title"] = "Portfolio";
}

<div class="container">

    <section class="syntech-public-page">

        <div class="text-center syntech-public-page-header">

            <span class="text-uppercase fw-bold syntech-section-label">
                Syntech Software
            </span>

            <h1 class="display-5 fw-bold mt-2 syntech-section-title">
                Recent <span>Work</span>
            </h1>

            <p class="lead text-muted mx-auto">
                Custom digital solutions built to work for businesses.
            </p>

        </div>


        <div class="row justify-content-center">

            <div class="col-lg-9">

                <div class="syntech-portfolio-card">

                    <div class="syntech-portfolio-image">

                        <img src="~/images/portfolio-edm-fabricators.png"
                             alt="EDM Fabricators project developed by Syntech Software" />

                    </div>

                    <div class="syntech-portfolio-content">

                        <span class="syntech-card-label">
                            Industrial IoT &middot; RPA
                        </span>

                        <h2 class="h3 fw-bold mt-2">
                            EDM Fabricators
                        </h2>

                        <div class="small fw-bold mb-3"
                             style="color: #0076E0;">
                            Web Development &middot; B2B
                        </div>

                        <p class="text-muted">
                            Full technical digital presence for a heavy industrial sector supplier featuring high-uptime architecture and streamlined B2B lead generation. Includes product catalogues, enquiry management, and CMS-driven content.
                        </p>

                        <p class="text-muted">
                            Developed by: Claudio Watson
                        </p>

                        <a href="https://edmfabricatorsza.co.za"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="syntech-primary-btn">
                            <i class="bi bi-box-arrow-up-right me-2"></i>
                            Visit EDM Fabricators
                        </a>

                    </div>

                </div>

            </div>

        </div>


        <div class="text-center syntech-portfolio-cta">

            <h2 class="h3 fw-bold">
                Your Project Next?
            </h2>

            <p class="text-muted">
                Tell us what you're working on and we'll figure out the best path forward.
            </p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="syntech-primary-btn">
                <i class="bi bi-chat-dots me-2"></i>
                Get in Touch
            </a>

        </div>

    </section>

</div>