@* =========================================================
   Views/Home/Services.cshtml
   ========================================================= *@

@{
    ViewData["Title"] = "Services";
}

<div class="container">

    <section class="py-5">

        <div class="text-center mb-5">

            <span class="text-uppercase fw-bold"
                  style="color: #0076E0; letter-spacing: 1px;">
                Syntech Software
            </span>

            <h1 class="display-5 fw-bold mt-2" style="color: #202836;">
                Our <span style="color: #0076E0;">Services</span>
            </h1>

            <p class="lead text-muted mx-auto"
               style="max-width: 750px;">
                We deliver high-performance solutions from full-stack development to
                Industrial IoT and Robotic Process Automation &mdash; built to scale with your business.
            </p>

        </div>


        <div class="row g-4">

            <!-- WEB DEVELOPMENT -->
            <div class="col-lg-4">

                <div class="bg-white border rounded-3 shadow-sm p-4 h-100">

                    <div class="mb-4" style="color: #0076E0;">
                        <i class="bi bi-code-slash fs-1"></i>
                    </div>

                    <h2 class="h4 fw-bold" style="color: #202836;">
                        Web Development
                    </h2>

                    <p class="text-muted">
                        We build robust, high-performance web applications using cutting-edge technologies. Whether you need an internal business tool, a customer-facing platform, or a complex enterprise system — our team delivers scalable solutions with clean architecture.
                    </p>

                    <div class="mt-4">

                        <span class="badge text-bg-light me-1 mb-1">
                            ASP.NET
                        </span>

                        <span class="badge text-bg-light me-1 mb-1">
                            React
                        </span>

                        <span class="badge text-bg-light mb-1">
                            Node.js
                        </span>

                        <span class="badge text-bg-light me-1 mb-1">
                            Tailwind
                        </span>

                        <span class="badge text-bg-light me-1 mb-1">
                            PHP
                        </span>

                        <span class="badge text-bg-light mb-1">
                            SQL Server
                        </span>

                    </div>

                </div>

            </div>


            <!-- MOBILE APPS -->
            <div class="col-lg-4">

                <div class="bg-white border rounded-3 shadow-sm p-4 h-100">

                    <div class="mb-4" style="color: #0076E0;">
                        <i class="bi bi-phone fs-1"></i>
                    </div>

                    <h2 class="h4 fw-bold" style="color: #202836;">
                        Mobile Apps
                    </h2>

                    <p class="text-muted">
                        We design and develop native and cross-platform mobile applications for iOS and Android. Our strategic approach ensures your app not only functions flawlessly but drives real user engagement and business value.
                    </p>

                    <div class="mt-4">

                        <span class="badge text-bg-light me-1 mb-1">
                            Kotlin
                        </span>

                        <span class="badge text-bg-light me-1 mb-1">
                            Swift
                        </span>

                        <span class="badge text-bg-light mb-1">
                            React Native
                        </span>

                        <span class="badge text-bg-light me-1 mb-1">
                            UX/UI
                        </span>

                        <span class="badge text-bg-light me-1 mb-1">
                            Firebase
                        </span>

                        <span class="badge text-bg-light mb-1">
                            ASO
                        </span>

                    </div>

                </div>

            </div>


            <!-- INDUSTRIAL IOT & RPA -->
            <div class="col-lg-4">

                <div class="bg-white border rounded-3 shadow-sm p-4 h-100">

                    <div class="mb-4" style="color: #0076E0;">
                        <i class="bi bi-gear fs-1"></i>
                    </div>

                    <h2 class="h4 fw-bold" style="color: #202836;">
                        Industrial IoT &amp; RPA
                    </h2>

                    <p class="text-muted">
                        We connect physical devices and industrial systems to powerful software platforms, enabling real-time monitoring, predictive maintenance, and data-driven decision making across your operations.
                    </p>

                    <div class="mt-4">

                        <span class="badge text-bg-light me-1 mb-1">
                            IoT
                        </span>

                        <span class="badge text-bg-light me-1 mb-1">
                            MQTT
                        </span>

                        <span class="badge text-bg-light mb-1">
                            Edge
                        </span>

                        <span class="badge text-bg-light me-1 mb-1">
                            Cloud
                        </span>

                        <span class="badge text-bg-light me-1 mb-1">
                            RPA
                        </span>

                        <span class="badge text-bg-light mb-1">
                            Python
                        </span>

                        <span class="badge text-bg-light mb-1">
                            AI/ML
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <div class="text-center mt-5">

            <p class="text-muted mb-4">
                Our multidisciplinary team combines technical depth with business insight to
                create solutions that don't just function &mdash; they drive measurable results.
            </p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="syntech-primary-btn">
                <i class="bi bi-chat-dots me-2"></i>
                Get in Touch
            </a>

        </div>

    </section>

</div>