@model IEnumerable<Syntech.WebApp.Models.Consultation>

@{
    ViewData["Title"] = "Consultation Management";
}

<div class="container py-4 mb-5">

    <!-- Page Header -->
    <div class="consultation-page-header">

        <div class="consultation-page-heading">

            <div class="consultation-title-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div>
                <h1 class="consultation-page-title">
                    Consultation Management
                </h1>

                <p class="consultation-page-subtitle">
                    Review and manage client consultation requests.
                </p>
            </div>

        </div>

        <a asp-controller="Consultation"
           asp-action="Calendar"
           class="consultation-secondary-btn">

            <i class="bi bi-calendar3 me-1"></i>
            Calendar View

        </a>

    </div>


    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert syntech-success-alert alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            <div>
                @TempData["SuccessMessage"]
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert syntech-error-alert alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            <div>
                @TempData["ErrorMessage"]
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="consultation-card">

            <div class="consultation-empty-state">

                <div class="consultation-empty-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <h4>No Consultations Found</h4>

                <p class="text-muted mb-0">
                    There are currently no consultation requests to manage.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- Consultation Management Table -->
        <div class="consultation-card">

            <div class="consultation-card-header">

                <div>
                    <h5 class="mb-1">
                        Consultation Requests
                    </h5>

                    <p class="text-muted mb-0">
                        Review consultation requests and manage their status.
                    </p>
                </div>

                <span class="consultation-count">
                    @Model.Count()
                    @(Model.Count() == 1 ? "request" : "requests")
                </span>

            </div>


            <div class="table-responsive">

                <table class="table syntech-consultation-table align-middle mb-0">

                    <thead>
                        <tr>

                            <th class="px-4">
                                ID
                            </th>

                            <th>
                                Client
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Time
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Description
                            </th>

                            <th class="text-end px-4">
                                Actions
                            </th>

                        </tr>
                    </thead>


                    <tbody>

                        @foreach (var consultation in Model)
                        {
                            <tr>

                                <td class="px-4">

                                    <span class="consultation-id">
                                        #@consultation.ConsultationID
                                    </span>

                                </td>


                                <td>

                                    @if (consultation.Client != null)
                                    {
                                        <span class="consultation-client">

                                            <span class="consultation-client-icon">
                                                <i class="bi bi-person"></i>
                                            </span>

                                            @consultation.Client.Name

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Unknown client
                                        </span>
                                    }

                                </td>


                                <td>

                                    <span class="consultation-date">

                                        <i class="bi bi-calendar3 me-2"></i>

                                        @consultation.BookingDate.ToString("dd MMM yyyy")

                                    </span>

                                </td>


                                <td>

                                    <span class="consultation-time">

                                        <i class="bi bi-clock me-2"></i>

                                        @consultation.BookingTime.ToString(@"hh\:mm")

                                    </span>

                                </td>


                                <td>

                                    @if (consultation.Status == "Pending")
                                    {
                                        <span class="consultation-status consultation-status-pending">
                                            <i class="bi bi-hourglass-split me-1"></i>
                                            Pending
                                        </span>
                                    }
                                    else if (consultation.Status == "Approved")
                                    {
                                        <span class="consultation-status consultation-status-approved">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Approved
                                        </span>
                                    }
                                    else if (consultation.Status == "Cancelled")
                                    {
                                        <span class="consultation-status consultation-status-cancelled">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Cancelled
                                        </span>
                                    }
                                    else if (consultation.Status == "Completed")
                                    {
                                        <span class="consultation-status consultation-status-completed">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="consultation-status consultation-status-default">
                                            @consultation.Status
                                        </span>
                                    }

                                </td>


                                <td class="consultation-description-cell">

                                    @if (!string.IsNullOrWhiteSpace(consultation.Description))
                                    {
                                        <span>
                                            @consultation.Description
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No description
                                        </span>
                                    }

                                </td>


                                <td class="text-end px-4">

                                    <div class="consultation-actions">

                                        @if (consultation.Status == "Pending")
                                        {
                                            <form asp-controller="Consultation"
                                                  asp-action="Approve"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@consultation.ConsultationID" />

                                                <button type="submit"
                                                        class="btn btn-sm consultation-approve-btn">

                                                    <i class="bi bi-check-lg me-1"></i>
                                                    Approve

                                                </button>

                                            </form>


                                            <form asp-controller="Consultation"
                                                  asp-action="Cancel"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@consultation.ConsultationID" />

                                                <button type="submit"
                                                        class="btn btn-sm consultation-action-cancel-btn">

                                                    <i class="bi bi-x-lg me-1"></i>
                                                    Cancel

                                                </button>

                                            </form>
                                        }


                                        @if (consultation.Status == "Approved")
                                        {
                                            <form asp-controller="Consultation"
                                                  asp-action="Complete"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@consultation.ConsultationID" />

                                                <button type="submit"
                                                        class="btn btn-sm consultation-complete-btn">

                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Complete

                                                </button>

                                            </form>


                                            <a asp-controller="Consultation"
                                               asp-action="Reschedule"
                                               asp-route-id="@consultation.ConsultationID"
                                               class="btn btn-sm consultation-reschedule-btn">

                                                <i class="bi bi-calendar-event me-1"></i>
                                                Reschedule

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>