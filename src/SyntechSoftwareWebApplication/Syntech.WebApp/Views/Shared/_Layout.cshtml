<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Syntech.WebApp
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Syntech.WebApp.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                @* =============================================================
                   APPLICATION BRAND
                   ============================================================= *@

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    Syntech.WebApp

                </a>


                @* =============================================================
                   MOBILE NAVIGATION TOGGLE
                   ============================================================= *@

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @* =========================================================
                       MAIN NAVIGATION
                       ========================================================= *@

                    <ul class="navbar-nav flex-grow-1">

                        @* -----------------------------------------------------
                           HOME
                           ----------------------------------------------------- *@

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        @* -----------------------------------------------------
                           PRIVACY
                           ----------------------------------------------------- *@

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">

                                Privacy

                            </a>

                        </li>


                        @* =====================================================
                           AUTHENTICATED USER NAVIGATION
                           ===================================================== *@

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* -------------------------------------------------
                               CLIENT DASHBOARD
                               -------------------------------------------------

                               Only display this navigation item when the
                               authenticated user's role is Client.

                               The controller itself also has:

                               [Authorize(Roles = "Client")]

                               Therefore this navigation item is not the
                               security mechanism. It is simply the correct
                               user interface for the authenticated role.
                            *@

                            @if (User.IsInRole("Client"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="ClientDashboard"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>
                            }


                            @* -------------------------------------------------
                               DEVELOPER DASHBOARD
                               ------------------------------------------------- *@

                            @if (User.IsInRole("Developer"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="DeveloperDashboard"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>
                            }


                            @* -------------------------------------------------
                               ADMIN DASHBOARD
                               ------------------------------------------------- *@

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="AdminDashboard"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>


                                @* -------------------------------------------------
                                   ADMIN USER MANAGEMENT

                                   The actual User Management controller will
                                   be implemented later.

                                   We are deliberately NOT adding a link to
                                   a controller that does not exist yet.
                                   ------------------------------------------------- *@
                            }


                            @* -------------------------------------------------
   PROFILE

   The Profile controller requires authentication,
   so this link is only displayed to authenticated
   users.
   ------------------------------------------------- *@

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Profile"
                                   asp-action="Index">

                                    Profile

                                </a>

                            </li>
                        }

                    </ul>

                    <li class="nav-item">

                        <a class="nav-link text-dark"
                           asp-area=""
                           asp-controller="AccountSecurity"
                           asp-action="ChangePassword">

                            Change Password

                        </a>

                    </li>


                    @* =========================================================
                       ACCOUNT NAVIGATION
                       ========================================================= *@

                    <ul class="navbar-nav">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* -------------------------------------------------
                               DISPLAY CURRENT USER
                               ------------------------------------------------- *@

                            <li class="nav-item">

                                <span class="nav-link text-dark">

                                    Hello,
                                    <strong>
                                        @User.Identity.Name
                                    </strong>

                                </span>

                            </li>


                            @* -------------------------------------------------
                               LOGOUT

                               Logout is intentionally implemented as a POST
                               request rather than a normal GET link.

                               This prevents a third party from triggering a
                               logout simply by causing the browser to visit
                               a logout URL.

                               The form also includes an antiforgery token.
                               ------------------------------------------------- *@

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="nav-link btn btn-link text-dark">

                                        Logout

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            @* -------------------------------------------------
                               LOGIN
                               ------------------------------------------------- *@

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>


                            @* -------------------------------------------------
                               REGISTER
                               ------------------------------------------------- *@

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    @* =============================================================
       MAIN CONTENT
       ============================================================= *@

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    @* =============================================================
       FOOTER
       ============================================================= *@

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - Syntech.WebApp -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>


    @* =============================================================
       JAVASCRIPT
       ============================================================= *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>