<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Syntech Software (PTY) LTD
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Syntech.WebApp.styles.css"
          asp-append-version="true" />

    <link rel="icon"
          type="image/png"
          href="~/images/syntech-logo.png" />
</head>

<body class="syntech-body">

    <header>

        <nav class="navbar navbar-expand-lg syntech-navbar">

            <div class="container-fluid px-4">

                @* =============================================================
                   APPLICATION BRAND
                   ============================================================= *@

                <a class="navbar-brand syntech-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/syntech-logo.png"
                         alt="Syntech Software Logo"
                         class="syntech-logo" />

                    <span class="syntech-brand-name">Syntech</span>
                    <span class="syntech-brand-app">Software</span>

                </a>


                @* =============================================================
                   MOBILE NAVIGATION TOGGLE
                   ============================================================= *@

                <button class="navbar-toggler syntech-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="navbar-collapse collapse"
                     id="navbarSupportedContent">

                    @* =========================================================
                       MAIN NAVIGATION
                       ========================================================= *@

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 syntech-main-nav">

                        @* -----------------------------------------------------
                           HOME
                           ----------------------------------------------------- *@

                        <li class="nav-item">

                            <a class="nav-link syntech-nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        @* =====================================================
                           AUTHENTICATED USER NAVIGATION
                           ===================================================== *@

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* -------------------------------------------------
                               CLIENT NAVIGATION
                               ------------------------------------------------- *@

                            @if (User.IsInRole("Client"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="ClientDashboard"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="Ticket"
                                       asp-action="Index">

                                        Support Tickets

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="Document"
                                       asp-action="Manage">

                                        Documents

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="Consultation"
                                       asp-action="Manage">

                                        Consultations

                                    </a>

                                </li>
                            }


                            @* -------------------------------------------------
                               DEVELOPER NAVIGATION
                               ------------------------------------------------- *@

                            @if (User.IsInRole("Developer"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="DeveloperDashboard"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="Ticket"
                                       asp-action="Index">

                                        Support Tickets

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="Document"
                                       asp-action="Manage">

                                        Documents

                                    </a>

                                </li>
                            }


                            @* -------------------------------------------------
                               ADMIN NAVIGATION
                               ------------------------------------------------- *@

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="AdminDashboard"
                                       asp-action="Index">

                                        Dashboard

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="Project"
                                       asp-action="Index">

                                        Projects

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="Ticket"
                                       asp-action="Index">

                                        Support Tickets

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="Document"
                                       asp-action="Manage">

                                        Documents

                                    </a>

                                </li>

                                <li class="nav-item">

                                    <a class="nav-link syntech-nav-link"
                                       asp-area=""
                                       asp-controller="Consultation"
                                       asp-action="AdminBookings">

                                        Consultations

                                    </a>

                                </li>
                            }
                        }

                    </ul>


                    @* =========================================================
                       ACCOUNT NAVIGATION
                       ========================================================= *@

                    <ul class="navbar-nav syntech-account-nav">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* -------------------------------------------------
                               PROFILE
                               ------------------------------------------------- *@

                            <li class="nav-item">

                                <a class="nav-link syntech-nav-link"
                                   asp-area=""
                                   asp-controller="Profile"
                                   asp-action="Index">

                                    Profile

                                </a>

                            </li>


                            @* -------------------------------------------------
                               CURRENT USER
                               ------------------------------------------------- *@

                            <li class="nav-item syntech-user">

                                <span class="nav-link syntech-user-link">

                                    Hello,
                                    <strong>
                                        @User.Identity.Name
                                    </strong>

                                </span>

                            </li>


                            @* -------------------------------------------------
                               CHANGE PASSWORD
                               ------------------------------------------------- *@

                            <li class="nav-item">

                                <a class="nav-link syntech-nav-link"
                                   asp-area=""
                                   asp-controller="AccountSecurity"
                                   asp-action="ChangePassword">

                                    Change Password

                                </a>

                            </li>


                            @* -------------------------------------------------
                               LOGOUT
                               ------------------------------------------------- *@

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="nav-link btn btn-link syntech-logout">

                                        Logout

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            @* -------------------------------------------------
                               LOGIN
                               ------------------------------------------------- *@

                            <li class="nav-item">

                                <a class="nav-link syntech-nav-link"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>


                            @* -------------------------------------------------
                               REGISTER
                               ------------------------------------------------- *@

                            <li class="nav-item">

                                <a class="nav-link syntech-register"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    @* =============================================================
       MAIN CONTENT
       ============================================================= *@

    <div class="container syntech-main-container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    @* =============================================================
       FOOTER
       ============================================================= *@

    <footer class="syntech-footer">

        <div class="container">

            <div class="syntech-footer-content">

                <div class="syntech-footer-brand">

                    <span class="syntech-footer-title">
                        Syntech Software (PTY) LTD
                    </span>

                    <span class="syntech-footer-text">
                        Secure software solutions and client collaboration.
                    </span>

                </div>


                <div class="syntech-footer-links">

                    <span>
                        &copy; 2026 Syntech Software (PTY) LTD - Developed by Dev Verse (INSY7315)
                    </span>

                    <span class="syntech-footer-divider">
                        |
                    </span>

                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Privacy">

                        Privacy Policy

                    </a>

                </div>

            </div>

        </div>

    </footer>


    @* =============================================================
       JAVASCRIPT
       ============================================================= *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>