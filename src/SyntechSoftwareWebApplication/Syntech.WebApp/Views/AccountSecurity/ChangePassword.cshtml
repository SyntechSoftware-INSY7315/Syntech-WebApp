@model Syntech.WebApp.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="security-page">

    <div class="security-container">

        <!-- =========================================================
             PAGE HEADER
             ========================================================= -->

        <div class="security-header">

            <div class="security-avatar">
                🔒
            </div>

            <div>

                <span class="security-eyebrow">
                    ACCOUNT SECURITY
                </span>

                <h1>
                    Change Password
                </h1>

                <p>
                    Update the password used to sign in to your
                    Syntech Software account.
                </p>

            </div>

        </div>


        <!-- =========================================================
             SUCCESS MESSAGE
             ========================================================= -->
        @if (TempData["PasswordSuccess"] != null)
        {
            <div class="security-alert security-alert-success"
                 role="alert">

                <span class="security-alert-icon">
                    ✓
                </span>

                <span>
                    @TempData["PasswordSuccess"]
                </span>

            </div>
        }


        <!-- =========================================================
             VALIDATION SUMMARY
             ========================================================= -->

        <div asp-validation-summary="ModelOnly"
             class="security-validation"
             role="alert">
        </div>


        <!-- =========================================================
             PASSWORD CARD
             ========================================================= -->

        <div class="security-card">

            <div class="security-card-header">

                <div>

                    <h2>
                        Update Your Password
                    </h2>

                    <p>
                        Enter your current password and choose a new
                        password for your account.
                    </p>

                </div>

            </div>


            <div class="security-card-body">

                <!-- =================================================
                     CHANGE PASSWORD FORM
                     ================================================= -->

                <form asp-controller="AccountSecurity"
                      asp-action="ChangePassword"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- =============================================
                         CURRENT PASSWORD
                         ============================================= -->

                    <div class="security-field">

                        <label asp-for="CurrentPassword"
                               class="security-label">
                        </label>

                        <input asp-for="CurrentPassword"
                               class="security-input"
                               autocomplete="current-password"
                               placeholder="Enter your current password" />

                        <span asp-validation-for="CurrentPassword"
                              class="security-field-validation">
                        </span>

                    </div>


                    <!-- =============================================
                         NEW PASSWORD
                         ============================================= -->

                    <div class="security-field">

                        <label asp-for="NewPassword"
                               class="security-label">
                        </label>

                        <input asp-for="NewPassword"
                               class="security-input"
                               autocomplete="new-password"
                               placeholder="Enter your new password" />

                        <span asp-validation-for="NewPassword"
                              class="security-field-validation">
                        </span>

                        <span class="security-help">
                            Your password must be between 8 and
                            100 characters.
                        </span>

                    </div>


                    <!-- =============================================
                         CONFIRM NEW PASSWORD
                         ============================================= -->

                    <div class="security-field security-confirm-field">

                        <label asp-for="ConfirmNewPassword"
                               class="security-label">
                        </label>

                        <input asp-for="ConfirmNewPassword"
                               class="security-input"
                               autocomplete="new-password"
                               placeholder="Confirm your new password" />

                        <span asp-validation-for="ConfirmNewPassword"
                              class="security-field-validation">
                        </span>

                    </div>


                    <!-- =============================================
                         PASSWORD REQUIREMENTS
                         ============================================= -->

                    <div class="password-requirements">

                        <div class="requirements-icon">
                            i
                        </div>

                        <div>

                            <strong>
                                Password requirements
                            </strong>

                            <p>
                                Use a password between 8 and 100
                                characters. Avoid using easily
                                guessable information.
                            </p>

                        </div>

                    </div>


                    <!-- =============================================
                         ACTIONS
                         ============================================= -->

                    <div class="security-actions">

                        <button type="submit"
                                class="security-save-button">
                            Change Password
                        </button>

                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="security-back-button">
                            Back to Profile
                        </a>

                    </div>

                </form>

            </div>

        </div>


        <!-- =========================================================
             SECURITY INFORMATION
             ========================================================= -->

        <div class="security-info">

            <div class="security-info-icon">
                ✓
            </div>

            <div>

                <h3>
                    Keep your account secure
                </h3>

                <p>
                    Never share your password with anyone. If you
                    believe your account has been compromised, change
                    your password immediately.
                </p>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     CHANGE PASSWORD STYLING
     ============================================================= -->

<style>

    .security-page {
        min-height: calc(100vh - 130px);
        background: #f8fafc;
        padding: 42px 20px 60px;
    }

    .security-container {
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .security-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
    }

    .security-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 58px;
        height: 58px;
        border-radius: 14px;
        background: #eef2ff;
        font-size: 23px;
    }

    .security-eyebrow {
        display: block;
        margin-bottom: 5px;
        color: #4169e1;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .security-header h1 {
        margin: 0 0 5px;
        color: #172033;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.4px;
    }

    .security-header p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }


    /* =========================================================
           ALERTS
           ========================================================= */

    .security-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 16px;
        margin-bottom: 20px;
        border-radius: 8px;
        font-size: 14px;
    }

    .security-alert-success {
        border: 1px solid #b7ebd0;
        background: #f0fdf4;
        color: #166534;
    }

    .security-alert-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #16a34a;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
    }

    .security-validation {
        margin-bottom: 20px;
        color: #b42318;
        font-size: 13px;
    }

        .security-validation:empty {
            display: none;
        }


    /* =========================================================
           PASSWORD CARD
           ========================================================= */

    .security-card {
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
    }

    .security-card-header {
        padding: 23px 28px;
        border-bottom: 1px solid #e2e8f0;
    }

        .security-card-header h2 {
            margin: 0 0 5px;
            color: #172033;
            font-size: 19px;
            font-weight: 700;
        }

        .security-card-header p {
            margin: 0;
            color: #64748b;
            font-size: 13px;
        }

    .security-card-body {
        padding: 28px;
    }


    /* =========================================================
           FORM
           ========================================================= */

    .security-field {
        margin-bottom: 21px;
    }

    .security-confirm-field {
        margin-bottom: 24px;
    }

    .security-label {
        display: block;
        margin-bottom: 8px;
        color: #172033;
        font-size: 14px;
        font-weight: 600;
    }

    .security-input {
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        color: #172033;
        font-size: 14px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .security-input::placeholder {
            color: #94a3b8;
        }

        .security-input:focus {
            outline: none;
            border-color: #4169e1;
            box-shadow: 0 0 0 3px rgba(65, 105, 225, 0.12);
        }

    .security-field-validation {
        display: block;
        margin-top: 6px;
        color: #dc3545;
        font-size: 13px;
    }

    .security-help {
        display: block;
        margin-top: 7px;
        color: #94a3b8;
        font-size: 12px;
    }


    /* =========================================================
           PASSWORD REQUIREMENTS
           ========================================================= */

    .password-requirements {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 26px;
        padding: 14px;
        border: 1px solid #dbe4ff;
        border-radius: 8px;
        background: #f8faff;
    }

    .requirements-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #4169e1;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
    }

    .password-requirements strong {
        display: block;
        margin-bottom: 3px;
        color: #172033;
        font-size: 13px;
    }

    .password-requirements p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
           ACTIONS
           ========================================================= */

    .security-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 3px;
    }

    .security-save-button,
    .security-back-button {
        min-height: 42px;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .security-save-button {
        border: 1px solid #4169e1;
        background: #4169e1;
        color: #ffffff;
    }

        .security-save-button:hover {
            border-color: #3157d5;
            background: #3157d5;
            color: #ffffff;
            box-shadow: 0 5px 14px rgba(65, 105, 225, 0.2);
            transform: translateY(-1px);
        }

    .security-back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #475569;
    }

        .security-back-button:hover {
            border-color: #94a3b8;
            background: #f8fafc;
            color: #172033;
            text-decoration: none;
        }


    /* =========================================================
           SECURITY INFORMATION
           ========================================================= */

    .security-info {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-top: 20px;
        padding: 18px 20px;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        background: #ffffff;
    }

    .security-info-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        border-radius: 9px;
        background: #ecfdf5;
        color: #059669;
        font-size: 16px;
        font-weight: 700;
    }

    .security-info h3 {
        margin: 0 0 4px;
        color: #172033;
        font-size: 14px;
        font-weight: 700;
    }

    .security-info p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 768px) {

        .security-page {
            padding: 30px 15px 45px;
        }

        .security-header {
            align-items: flex-start;
        }

            .security-header h1 {
                font-size: 27px;
            }

        .security-card-body {
            padding: 23px 20px;
        }

        .security-card-header {
            padding: 20px;
        }
    }


    @@media (max-width: 576px) {

        .security-header {
            flex-direction: column;
        }

        .security-avatar {
            width: 50px;
            height: 50px;
        }

        .security-actions {
            flex-direction: column;
        }

        .security-save-button,
        .security-back-button {
            width: 100%;
        }

        .password-requirements {
            align-items: flex-start;
        }
    }

</style>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}