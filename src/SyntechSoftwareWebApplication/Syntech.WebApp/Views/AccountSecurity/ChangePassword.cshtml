@model Syntech.WebApp.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<link rel="stylesheet" href="~/css/change-password.css" asp-append-version="true" />

<div class="password-page">
    <div class="password-container">

        <header class="password-header">
            <div class="password-header-icon" aria-hidden="true">
                <icon name="shield-check" />
            </div>

            <div>
                <span class="password-eyebrow">ACCOUNT SECURITY</span>
                <h1>Change Password</h1>
                <p>Update the password used to access your Syntech Software account.</p>
            </div>
        </header>

        @if (TempData["PasswordSuccess"] != null)
        {
            <div class="password-alert password-alert-success" role="status">
                <span class="password-alert-icon" aria-hidden="true">✓</span>
                <span>@TempData["PasswordSuccess"]</span>
            </div>
        }

        <div asp-validation-summary="ModelOnly"
             class="password-validation-summary"
             role="alert">
        </div>

        <section class="password-card">

            <div class="password-card-header">
                <div>
                    <h2>Update Your Password</h2>
                    <p>Enter your current password and choose a new one.</p>
                </div>

                <div class="password-card-icon" aria-hidden="true">
                    <icon name="lock-keyhole" />
                </div>
            </div>

            <div class="password-card-body">

                <form asp-controller="AccountSecurity"
                      asp-action="ChangePassword"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="password-field">
                        <label asp-for="CurrentPassword"
                               class="password-label"></label>

                        <input asp-for="CurrentPassword"
                               class="password-input"
                               autocomplete="current-password"
                               placeholder="Enter your current password" />

                        <span asp-validation-for="CurrentPassword"
                              class="password-field-error">
                        </span>
                    </div>

                    <div class="password-field">
                        <label asp-for="NewPassword"
                               class="password-label"></label>

                        <input asp-for="NewPassword"
                               class="password-input"
                               autocomplete="new-password"
                               placeholder="Enter your new password" />

                        <span asp-validation-for="NewPassword"
                              class="password-field-error">
                        </span>
                    </div>

                    <div class="password-field">
                        <label asp-for="ConfirmNewPassword"
                               class="password-label"></label>

                        <input asp-for="ConfirmNewPassword"
                               class="password-input"
                               autocomplete="new-password"
                               placeholder="Confirm your new password" />

                        <span asp-validation-for="ConfirmNewPassword"
                              class="password-field-error">
                        </span>
                    </div>

                    <div class="password-requirements">
                        <div class="requirements-icon" aria-hidden="true">
                            <icon name="info" />
                        </div>

                        <div>
                            <h3>Password requirements</h3>
                            <p>
                                Your password must contain between
                                8 and 100 characters. Avoid using
                                easily guessable personal information.
                            </p>
                        </div>
                    </div>

                    <div class="password-actions">
                        <button type="submit" class="password-submit">
                            <icon name="shield-check" />
                            Change Password
                        </button>

                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="password-back">
                            Back to Profile
                        </a>
                    </div>

                </form>
            </div>
        </section>

        <aside class="password-security-note">
            <div class="security-note-icon" aria-hidden="true">
                <icon name="shield-check" />
            </div>

            <div>
                <h3>Keep your account secure</h3>
                <p>
                    Never share your password with anyone.
                    If you believe your account has been compromised,
                    change your password immediately.
                </p>
            </div>
        </aside>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
