@model Syntech.WebApp.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h1 class="mb-3">
                        Change Password
                    </h1>

                    <p class="text-muted mb-4">
                        Update the password used to sign in to your
                        Syntech Software account.
                    </p>


                    @* =====================================================
                       SUCCESS MESSAGE
                       ===================================================== *@

                    @if (TempData["PasswordSuccess"] != null)
                    {
                        <div class="alert alert-success"
                             role="alert">

                            @TempData["PasswordSuccess"]

                        </div>
                    }


                    @* =====================================================
                       VALIDATION SUMMARY
                       ===================================================== *@

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    @* =====================================================
                       CHANGE PASSWORD FORM
                       ===================================================== *@

                    <form asp-controller="AccountSecurity"
                          asp-action="ChangePassword"
                          method="post">

                        @Html.AntiForgeryToken()


                        @* =================================================
                           CURRENT PASSWORD
                           ================================================= *@

                        <div class="mb-3">

                            <label asp-for="CurrentPassword"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="CurrentPassword"
                                   class="form-control"
                                   autocomplete="current-password" />

                            <span asp-validation-for="CurrentPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        @* =================================================
                           NEW PASSWORD
                           ================================================= *@

                        <div class="mb-3">

                            <label asp-for="NewPassword"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger">
                            </span>

                            <small class="form-text text-muted">
                                Your password must be between 8 and
                                100 characters.
                            </small>

                        </div>


                        @* =================================================
                           CONFIRM NEW PASSWORD
                           ================================================= *@

                        <div class="mb-4">

                            <label asp-for="ConfirmNewPassword"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="ConfirmNewPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmNewPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        @* =================================================
                           ACTION BUTTONS
                           ================================================= *@

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Change Password

                            </button>

                            <a asp-controller="Profile"
                               asp-action="Index"
                               class="btn btn-secondary">

                                Back to Profile

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}