@model Syntech.WebApp.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/account-auth.css" asp-append-version="true" />

<div class="auth-page auth-page-login">
    <div class="auth-container">
        <div class="auth-card">

            <div class="auth-brand">
                <span class="auth-eyebrow">SYNTECH SOFTWARE</span>

                <img src="~/images/syntech-logo.png"
                     alt="Syntech Software"
                     class="auth-logo" />

                <h1>Welcome Back</h1>

                <p>Sign in to your Syntech Software account.</p>
            </div>

            @if (TempData["RegistrationSuccess"] != null)
            {
                <div class="auth-alert auth-alert-success"
                     role="alert">
                    <strong>Account created.</strong>
                    <span>@TempData["RegistrationSuccess"]</span>
                </div>
            }

            <div asp-validation-summary="ModelOnly"
                 class="auth-alert auth-alert-error"
                 role="alert">
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  class="auth-form">

                @Html.AntiForgeryToken()

                @if (ViewData["ReturnUrl"] != null)
                {
                    <input type="hidden"
                           name="returnUrl"
                           value="@ViewData["ReturnUrl"]" />
                }

                <div class="auth-field">
                    <label asp-for="Email" class="auth-label"></label>

                    <input asp-for="Email"
                           class="auth-input"
                           autocomplete="email"
                           autofocus
                           placeholder="Enter your email address" />

                    <span asp-validation-for="Email"
                          class="auth-validation"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password" class="auth-label"></label>

                    <input asp-for="Password"
                           class="auth-input"
                           autocomplete="current-password"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Password"
                          class="auth-validation"></span>
                </div>

                <div class="auth-options">
                    <label class="remember-option">
                        <input asp-for="RememberMe"
                               class="remember-checkbox" />

                        <span>
                            @Html.DisplayNameFor(model => model.RememberMe)
                        </span>
                    </label>
                </div>

                <button type="submit" class="auth-submit">
                    Sign In
                </button>
            </form>

            <div class="auth-divider">
                <span>New to Syntech?</span>
            </div>

            <div class="auth-register">
                <p>Don't have an account?</p>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="auth-register-link">
                    Create an account
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
