@model Syntech.WebApp.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/account-auth.css" asp-append-version="true" />

<div class="auth-page auth-page-register">
    <div class="auth-container">
        <div class="auth-card">

            <div class="auth-brand">
                <span class="auth-eyebrow">SYNTECH SOFTWARE</span>

                <h1>Create Your Account</h1>
                <p>Join Syntech Software and get started.</p>
            </div>

            <div asp-validation-summary="ModelOnly"
                 class="auth-alert auth-alert-error"
                 role="alert">
            </div>

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post"
                  class="auth-form">

                @Html.AntiForgeryToken()

                <div class="auth-field">
                    <label asp-for="Name" class="auth-label"></label>
                    <input asp-for="Name"
                           class="auth-input"
                           autocomplete="name"
                           placeholder="Enter your full name" />
                    <span asp-validation-for="Name"
                          class="auth-validation"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Email" class="auth-label"></label>
                    <input asp-for="Email"
                           class="auth-input"
                           autocomplete="email"
                           placeholder="Enter your email address" />
                    <span asp-validation-for="Email"
                          class="auth-validation"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password" class="auth-label"></label>
                    <input asp-for="Password"
                           class="auth-input"
                           autocomplete="new-password"
                           placeholder="Create a password" />
                    <span asp-validation-for="Password"
                          class="auth-validation"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="ConfirmPassword"
                           class="auth-label"></label>
                    <input asp-for="ConfirmPassword"
                           class="auth-input"
                           autocomplete="new-password"
                           placeholder="Confirm your password" />
                    <span asp-validation-for="ConfirmPassword"
                          class="auth-validation"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Role" class="auth-label"></label>

                    <select asp-for="Role" class="auth-input">
                        <option value="">Select account type</option>
                        <option value="Client">Client</option>
                        <option value="Developer">Developer</option>
                    </select>

                    <span asp-validation-for="Role"
                          class="auth-validation"></span>
                </div>

                <button type="submit" class="auth-submit">
                    Create Account
                </button>
            </form>

            <div class="auth-divider">
                <span>Already registered?</span>
            </div>

            <div class="auth-register">
                <p>Already have a Syntech account?</p>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="auth-register-link">
                    Sign in instead
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
