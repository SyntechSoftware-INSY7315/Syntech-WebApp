@model Syntech.WebApp.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h1 class="mb-4">
                        My Profile
                    </h1>

                    <p class="text-muted mb-4">
                        View and update your Syntech Software account
                        information.
                    </p>


                    @* =====================================================
                       SUCCESS MESSAGE
                       ===================================================== *@

                    @if (TempData["ProfileSuccess"] != null)
                    {
                        <div class="alert alert-success"
                             role="alert">

                            @TempData["ProfileSuccess"]

                        </div>
                    }


                    @* =====================================================
                       VALIDATION / ERROR MESSAGES
                       ===================================================== *@

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    @* =====================================================
                       EDIT PROFILE FORM
                       =====================================================

                       Only Name is submitted as an editable property.

                       UserId, Email and Role are displayed separately as
                       read-only information and are not trusted by the
                       controller.
                    *@

                    <form asp-controller="Profile"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()


                        @* =================================================
                           USER ID
                           ================================================= *@

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                User ID
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.UserId"
                                   readonly />

                        </div>


                        @* =================================================
                           NAME
                           ================================================= *@

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label fw-bold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   autocomplete="name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        @* =================================================
                           EMAIL
                           ================================================= *@

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label fw-bold">
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.Email"
                                   readonly />

                            <small class="form-text text-muted">
                                Email address changes are not available
                                through the profile page.
                            </small>

                        </div>


                        @* =================================================
                           ROLE
                           ================================================= *@

                        <div class="mb-4">

                            <label asp-for="Role"
                                   class="form-label fw-bold">
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.Role"
                                   readonly />

                            <small class="form-text text-muted">
                                Your role is managed by the system and
                                cannot be changed from your profile.
                            </small>

                        </div>


                        @* =================================================
                           ACTION BUTTONS
                           ================================================= *@

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Save Changes

                            </button>

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}