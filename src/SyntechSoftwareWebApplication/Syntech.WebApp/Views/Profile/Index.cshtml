@model Syntech.WebApp.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="profile-page">
    <div class="profile-container">

        <!-- Page heading -->
        <header class="profile-header">
            <div class="profile-avatar" aria-hidden="true">
                @if (!string.IsNullOrWhiteSpace(Model.Name))
                {
                    @Model.Name.Substring(0, 1).ToUpper()
                }
                else
                {
                    <span>U</span>
                }
            </div>

            <div class="profile-heading-content">
                <span class="profile-eyebrow">ACCOUNT SETTINGS</span>
                <h1>My Profile</h1>
                <p>Manage your personal information and account security.</p>
            </div>
        </header>

        <!-- Success message -->
        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="profile-alert profile-alert-success" role="status">
                <span class="alert-icon" aria-hidden="true">✓</span>
                <span>@TempData["ProfileSuccess"]</span>
            </div>
        }

        <!-- Validation messages -->
        <div asp-validation-summary="ModelOnly"
             class="profile-validation"
             role="alert">
        </div>

        <!-- Profile information -->
        <section class="profile-card">

            <div class="profile-card-header">
                <div>
                    <h2>Personal Information</h2>
                    <p>View and update the information associated with your account.</p>
                </div>

                <span class="section-icon" aria-hidden="true">●</span>
            </div>

            <div class="profile-card-body">

                <form asp-controller="Profile"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="profile-field">
                        <label class="profile-label" for="UserId">
                            User ID
                        </label>

                        <input id="UserId"
                               type="text"
                               class="profile-input profile-readonly"
                               value="@Model.UserId"
                               readonly
                               aria-describedby="userid-help" />

                        <span id="userid-help" class="profile-help">
                            Your unique account identifier.
                        </span>
                    </div>

                    <div class="profile-field">
                        <label asp-for="Name" class="profile-label"></label>

                        <input asp-for="Name"
                               class="profile-input"
                               autocomplete="name"
                               aria-describedby="name-error" />

                        <span asp-validation-for="Name"
                              id="name-error"
                              class="profile-validation-message">
                        </span>

                        <span class="profile-help">
                            You can update the name displayed on your account.
                        </span>
                    </div>

                    <div class="profile-field">
                        <label class="profile-label" for="Email">
                            Email Address
                        </label>

                        <input id="Email"
                               type="email"
                               class="profile-input profile-readonly"
                               value="@Model.Email"
                               readonly
                               aria-describedby="email-help" />

                        <span id="email-help" class="profile-help">
                            Contact information cannot currently be changed here.
                        </span>
                    </div>

                    <div class="profile-field">
                        <label class="profile-label">Account Role</label>

                        <div class="role-display">
                            @if (Model.Role == "Admin")
                            {
                                <span class="role-badge admin-role">
                                    Administrator
                                </span>
                            }
                            else if (Model.Role == "Developer")
                            {
                                <span class="role-badge developer-role">
                                    Developer
                                </span>
                            }
                            else
                            {
                                <span class="role-badge client-role">
                                    Client
                                </span>
                            }
                        </div>

                        <span class="profile-help">
                            Your account role is managed by the system.
                        </span>
                    </div>

                    <div class="profile-actions">
                        <button type="submit" class="profile-save-button">
                            Save Changes
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="profile-cancel-button">
                            Cancel
                        </a>
                    </div>

                </form>
            </div>
        </section>

        <!-- Account security -->
        <section class="security-card">
            <div class="security-icon" aria-hidden="true">
                <span>🔒</span>
            </div>

            <div class="security-content">
                <h2>Account Security</h2>
                <p>
                    Protect your account by keeping your password secure
                    and updating it regularly.
                </p>
            </div>

            <a asp-controller="AccountSecurity"
               asp-action="ChangePassword"
               class="security-button">
                Change Password
                <span aria-hidden="true">→</span>
            </a>
        </section>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
