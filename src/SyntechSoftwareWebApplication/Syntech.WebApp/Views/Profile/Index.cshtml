@model Syntech.WebApp.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-page">

    <div class="profile-container">

        <!-- =========================================================
             PROFILE HEADER
             ========================================================= -->

        <div class="profile-header">

            <div class="profile-avatar">
                @if (!string.IsNullOrWhiteSpace(Model.Name))
                {
                    @Model.Name.Substring(0, 1).ToUpper()
                }
                else
                {
                    <span>U</span>
                }
            </div>

            <div>
                <span class="profile-eyebrow">
                    ACCOUNT SETTINGS
                </span>

                <h1>
                    My Profile
                </h1>

                <p>
                    View and update your Syntech Software account information.
                </p>
            </div>

        </div>


        <!-- =========================================================
             SUCCESS MESSAGE
             ========================================================= -->
        @if (TempData["ProfileSuccess"] != null)
        {
            <div class="profile-alert profile-alert-success"
                 role="alert">

                <span class="profile-alert-icon">
                    ✓
                </span>

                <span>
                    @TempData["ProfileSuccess"]
                </span>

            </div>
        }


        <!-- =========================================================
             VALIDATION / ERROR MESSAGES
             ========================================================= -->

        <div asp-validation-summary="ModelOnly"
             class="profile-validation"
             role="alert">
        </div>


        <!-- =========================================================
             PROFILE CARD
             ========================================================= -->

        <div class="profile-card">

            <div class="profile-card-header">

                <div>

                    <h2>
                        Account Information
                    </h2>

                    <p>
                        Update the personal information associated with
                        your account.
                    </p>

                </div>

            </div>


            <div class="profile-card-body">

                <form asp-controller="Profile"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- =============================================
                         USER ID
                         ============================================= -->

                    <div class="profile-field">

                        <label class="profile-label">
                            User ID
                        </label>

                        <input type="text"
                               class="profile-input profile-readonly"
                               value="@Model.UserId"
                               readonly />

                        <span class="profile-help">
                            Your unique Syntech account identifier.
                        </span>

                    </div>


                    <!-- =============================================
                         FULL NAME
                         ============================================= -->

                    <div class="profile-field">

                        <label asp-for="Name"
                               class="profile-label">
                        </label>

                        <input asp-for="Name"
                               class="profile-input"
                               autocomplete="name" />

                        <span asp-validation-for="Name"
                              class="profile-validation-message">
                        </span>

                    </div>


                    <!-- =============================================
                         EMAIL
                         ============================================= -->

                    <div class="profile-field">

                        <label asp-for="Email"
                               class="profile-label">
                        </label>

                        <input type="text"
                               class="profile-input profile-readonly"
                               value="@Model.Email"
                               readonly />

                        <span class="profile-help">
                            Email address changes are not available
                            through the profile page.
                        </span>

                    </div>


                    <!-- =============================================
                         ROLE
                         ============================================= -->

                    <div class="profile-field profile-role-field">

                        <label asp-for="Role"
                               class="profile-label">
                        </label>

                        <div class="role-display">

                            @if (Model.Role == "Admin")
                            {
                                <span class="role-badge admin-role">
                                    Administrator
                                </span>
                            }
                            else if (Model.Role == "Developer")
                            {
                                <span class="role-badge developer-role">
                                    Developer
                                </span>
                            }
                            else
                            {
                                <span class="role-badge client-role">
                                    Client
                                </span>
                            }

                        </div>

                        <span class="profile-help">
                            Your role is managed by the system and cannot
                            be changed from your profile.
                        </span>

                    </div>


                    <!-- =============================================
                         ACTIONS
                         ============================================= -->

                    <div class="profile-actions">

                        <button type="submit"
                                class="profile-save-button">
                            Save Changes
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="profile-cancel-button">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>


        <!-- =========================================================
             ACCOUNT SECURITY
             ========================================================= -->

        <div class="security-card">

            <div class="security-icon">
                🔒
            </div>

            <div class="security-content">

                <h3>
                    Account Security
                </h3>

                <p>
                    Keep your account secure by regularly updating
                    your password.
                </p>

            </div>

            <!-- Correct route: AccountSecurityController -->
            <a asp-controller="AccountSecurity"
               asp-action="ChangePassword"
               class="security-button">
                Change Password
            </a>

        </div>

    </div>

</div>


<!-- =============================================================
     PROFILE PAGE STYLING
     ============================================================= -->

<style>

    .profile-page {
        min-height: calc(100vh - 130px);
        background: #f8fafc;
        padding: 42px 20px 60px;
    }

    .profile-container {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .profile-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
    }

    .profile-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 58px;
        height: 58px;
        border-radius: 14px;
        background: #eef2ff;
        color: #4169e1;
        font-size: 23px;
        font-weight: 700;
    }

    .profile-eyebrow {
        display: block;
        margin-bottom: 5px;
        color: #4169e1;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .profile-header h1 {
        margin: 0 0 5px;
        color: #172033;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.4px;
    }

    .profile-header p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }


    /* =========================================================
           ALERTS
           ========================================================= */

    .profile-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 16px;
        margin-bottom: 20px;
        border-radius: 8px;
        font-size: 14px;
    }

    .profile-alert-success {
        border: 1px solid #b7ebd0;
        background: #f0fdf4;
        color: #166534;
    }

    .profile-alert-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #16a34a;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
    }

    .profile-validation {
        margin-bottom: 20px;
        color: #b42318;
        font-size: 13px;
    }

        .profile-validation:empty {
            display: none;
        }

    .profile-validation-message {
        display: block;
        margin-top: 6px;
        color: #dc3545;
        font-size: 13px;
    }


    /* =========================================================
           PROFILE CARD
           ========================================================= */

    .profile-card {
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
    }

    .profile-card-header {
        padding: 23px 28px;
        border-bottom: 1px solid #e2e8f0;
    }

        .profile-card-header h2 {
            margin: 0 0 5px;
            color: #172033;
            font-size: 19px;
            font-weight: 700;
        }

        .profile-card-header p {
            margin: 0;
            color: #64748b;
            font-size: 13px;
        }

    .profile-card-body {
        padding: 28px;
    }


    /* =========================================================
           FORM FIELDS
           ========================================================= */

    .profile-field {
        margin-bottom: 21px;
    }

    .profile-role-field {
        margin-bottom: 27px;
    }

    .profile-label {
        display: block;
        margin-bottom: 8px;
        color: #172033;
        font-size: 14px;
        font-weight: 600;
    }

    .profile-input {
        width: 100%;
        min-height: 46px;
        padding: 11px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        color: #172033;
        font-size: 14px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .profile-input:focus {
            outline: none;
            border-color: #4169e1;
            box-shadow: 0 0 0 3px rgba(65, 105, 225, 0.12);
        }

    .profile-readonly {
        background: #f8fafc;
        color: #64748b;
        cursor: not-allowed;
    }

    .profile-help {
        display: block;
        margin-top: 7px;
        color: #94a3b8;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
           ROLE DISPLAY
           ========================================================= */

    .role-display {
        display: flex;
        align-items: center;
        min-height: 46px;
        padding: 0 14px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .admin-role {
        background: #fff7ed;
        color: #c2410c;
    }

    .developer-role {
        background: #eef2ff;
        color: #4338ca;
    }

    .client-role {
        background: #ecfdf5;
        color: #047857;
    }


    /* =========================================================
           ACTION BUTTONS
           ========================================================= */

    .profile-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 4px;
    }

    .profile-save-button,
    .profile-cancel-button {
        min-height: 42px;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .profile-save-button {
        border: 1px solid #4169e1;
        background: #4169e1;
        color: #ffffff;
    }

        .profile-save-button:hover {
            border-color: #3157d5;
            background: #3157d5;
            color: #ffffff;
            box-shadow: 0 5px 14px rgba(65, 105, 225, 0.2);
            transform: translateY(-1px);
        }

    .profile-cancel-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #475569;
    }

        .profile-cancel-button:hover {
            border-color: #94a3b8;
            background: #f8fafc;
            color: #172033;
            text-decoration: none;
        }


    /* =========================================================
           SECURITY CARD
           ========================================================= */

    .security-card {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 20px;
        padding: 19px 22px;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        background: #ffffff;
        box-shadow: 0 3px 14px rgba(15, 23, 42, 0.04);
    }

    .security-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 42px;
        height: 42px;
        border-radius: 9px;
        background: #eef2ff;
        font-size: 17px;
    }

    .security-content {
        flex: 1;
    }

        .security-content h3 {
            margin: 0 0 4px;
            color: #172033;
            font-size: 15px;
            font-weight: 700;
        }

        .security-content p {
            margin: 0;
            color: #64748b;
            font-size: 12px;
        }

    .security-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 8px 14px;
        border: 1px solid #4169e1;
        border-radius: 7px;
        color: #4169e1;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .security-button:hover {
            background: #4169e1;
            color: #ffffff;
            text-decoration: none;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 768px) {

        .profile-page {
            padding: 30px 15px 45px;
        }

        .profile-header {
            align-items: flex-start;
        }

            .profile-header h1 {
                font-size: 27px;
            }

        .profile-card-body {
            padding: 23px 20px;
        }

        .profile-card-header {
            padding: 20px;
        }

        .security-card {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .security-button {
            width: 100%;
        }
    }


    @@media (max-width: 576px) {

        .profile-header {
            flex-direction: column;
        }

        .profile-avatar {
            width: 50px;
            height: 50px;
        }

        .profile-actions {
            flex-direction: column;
        }

        .profile-save-button,
        .profile-cancel-button {
            width: 100%;
        }
    }

</style>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}