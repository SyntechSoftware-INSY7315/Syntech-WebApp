@model Syntech.WebApp.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Administrator Dashboard";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />

<div class="admin-page">
    <div class="admin-container">

        <!-- Dashboard heading -->
        <header class="admin-header">
            <div>
                <span class="admin-eyebrow">ADMINISTRATION</span>
                <h1>Administrator Dashboard</h1>
                <p>Monitor registered accounts and manage the Syntech platform.</p>
            </div>

            <a asp-controller="UserManagement"
               asp-action="Create"
               class="admin-primary-button">
                <span aria-hidden="true">+</span>
                Create User
            </a>
        </header>

        <!-- User statistics -->
        <section class="admin-section" aria-labelledby="overview-heading">
            <div class="admin-section-heading">
                <div>
                    <h2 id="overview-heading">User Overview</h2>
                    <p>A summary of registered platform accounts.</p>
                </div>
            </div>

            <div class="statistics-grid">

                <article class="stat-card">
                    <div class="stat-card-top">
                        <span class="stat-icon total-icon" aria-hidden="true">U</span>
                        <span class="stat-label">All Accounts</span>
                    </div>
                    <strong class="stat-number">@Model.TotalUsers</strong>
                    <span class="stat-description">Total registered users</span>
                </article>

                <article class="stat-card">
                    <div class="stat-card-top">
                        <span class="stat-icon active-icon" aria-hidden="true">✓</span>
                        <span class="stat-label">Active</span>
                    </div>
                    <strong class="stat-number">@Model.ActiveUsers</strong>
                    <span class="stat-description">Currently active accounts</span>
                </article>

                <article class="stat-card">
                    <div class="stat-card-top">
                        <span class="stat-icon inactive-icon" aria-hidden="true">!</span>
                        <span class="stat-label">Deactivated</span>
                    </div>
                    <strong class="stat-number">@Model.DeactivatedUsers</strong>
                    <span class="stat-description">Deactivated accounts</span>
                </article>

            </div>
        </section>

        <!-- Role breakdown -->
        <section class="admin-section" aria-labelledby="roles-heading">
            <div class="admin-section-heading">
                <div>
                    <h2 id="roles-heading">Account Distribution</h2>
                    <p>Registered users grouped by account role.</p>
                </div>
            </div>

            <div class="role-grid">

                <article class="role-card">
                    <div class="role-card-header">
                        <span class="role-icon admin-role-icon" aria-hidden="true">A</span>
                        <span class="role-badge admin-badge">Admin</span>
                    </div>
                    <strong class="role-number">@Model.AdminCount</strong>
                    <h3>Administrators</h3>
                    <p>Accounts with administrative access.</p>
                </article>

                <article class="role-card">
                    <div class="role-card-header">
                        <span class="role-icon developer-role-icon" aria-hidden="true">D</span>
                        <span class="role-badge developer-badge">Developer</span>
                    </div>
                    <strong class="role-number">@Model.DeveloperCount</strong>
                    <h3>Developers</h3>
                    <p>Developer accounts registered on the platform.</p>
                </article>

                <article class="role-card">
                    <div class="role-card-header">
                        <span class="role-icon client-role-icon" aria-hidden="true">C</span>
                        <span class="role-badge client-badge">Client</span>
                    </div>
                    <strong class="role-number">@Model.ClientCount</strong>
                    <h3>Clients</h3>
                    <p>Client accounts registered on the platform.</p>
                </article>

            </div>
        </section>

        <!-- Recently registered users -->
        <section class="admin-content-card" aria-labelledby="recent-users-heading">

            <div class="admin-card-header">
                <div>
                    <h2 id="recent-users-heading">Recent Users</h2>
                    <p>The latest accounts registered on the platform.</p>
                </div>

                <a asp-controller="UserManagement"
                   asp-action="Index"
                   class="admin-secondary-button">
                    View All Users
                    <span aria-hidden="true">→</span>
                </a>
            </div>

            @if (Model.RecentUsers != null && Model.RecentUsers.Any())
            {
                <div class="admin-table-wrapper">
                    <table class="admin-table">
                        <caption class="visually-hidden">
                            Recently registered Syntech users and their account status.
                        </caption>

                        <thead>
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Name</th>
                                <th scope="col">Email Address</th>
                                <th scope="col">Role</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model.RecentUsers)
                            {
                                <tr>
                                    <td class="admin-user-id">#@user.UserId</td>

                                    <td class="admin-user-name">
                                        @user.Name
                                    </td>

                                    <td class="admin-user-email">
                                        @user.Email
                                    </td>

                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="admin-table-badge admin-badge">
                                                Admin
                                            </span>
                                        }
                                        else if (user.Role == "Developer")
                                        {
                                            <span class="admin-table-badge developer-badge">
                                                Developer
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-table-badge client-badge">
                                                Client
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="admin-status active-status">
                                                <span class="status-indicator"></span>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="admin-status inactive-status">
                                                <span class="status-indicator"></span>
                                                Deactivated
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="admin-empty-state">
                    <div class="empty-state-icon" aria-hidden="true">U</div>
                    <h3>No Users Yet</h3>
                    <p>No users have been registered on the platform yet.</p>

                    <a asp-controller="UserManagement"
                       asp-action="Create"
                       class="admin-primary-button">
                        Create First User
                    </a>
                </div>
            }
        </section>

        <!-- Quick actions -->
        <section class="admin-content-card quick-actions-section"
                 aria-labelledby="quick-actions-heading">

            <div class="admin-card-header">
                <div>
                    <h2 id="quick-actions-heading">Quick Actions</h2>
                    <p>Shortcuts to common administrative tasks.</p>
                </div>
            </div>

            <div class="admin-quick-actions">

                <a asp-controller="UserManagement"
                   asp-action="Index"
                   class="admin-action-card">

                    <span class="action-icon" aria-hidden="true">U</span>

                    <span class="action-content">
                        <strong>Manage Users</strong>
                        <span>View and manage registered accounts.</span>
                    </span>

                    <span class="action-arrow" aria-hidden="true">→</span>
                </a>

                <a asp-controller="UserManagement"
                   asp-action="Create"
                   class="admin-action-card">

                    <span class="action-icon create-action-icon" aria-hidden="true">+</span>

                    <span class="action-content">
                        <strong>Create User</strong>
                        <span>Add a new client or developer account.</span>
                    </span>

                    <span class="action-arrow" aria-hidden="true">→</span>
                </a>

            </div>
        </section>

    </div>
</div>
